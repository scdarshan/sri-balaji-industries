# Resend Email API – get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# "From" address (must use your verified Resend domain)
EMAIL_FROM=Sri Balaji Industries <enquiries@yourdomain.com>

# Business inbox that receives every enquiry
EMAIL_TO=sribalajiindustries@gmail.com

# Node port (Render sets this automatically)
PORT=3001

# Your production URL – used for CORS (no trailing slash)
SITE_URL=https://sri-balaji-industries.onrender.com

